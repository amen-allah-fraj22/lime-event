# Clerk (dashboard.clerk.com → API keys + Webhooks)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/role

# Supabase Session pooler (Connect → Session mode, port 5432) — works on Windows WiFi
# URL-encode special characters in the password (@ → %40, + → %2B, etc.)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# API
PORT=3001
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001
# CORS — comma-separated origins allowed by the API (set on Railway to your Vercel URL)
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# Show floating debug panel (default on in development)
# NEXT_PUBLIC_SHOW_DEBUG=true
COMMISSION_RATE=0.125

# Optional — public URL for uploaded files (defaults to http://localhost:PORT)
# UPLOAD_PUBLIC_BASE_URL=http://localhost:3001
